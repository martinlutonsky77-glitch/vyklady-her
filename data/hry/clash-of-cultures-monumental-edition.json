text-primary)\">1 ruda</text><circle cx=\"52\" cy=\"382\" r=\"8\" fill=\"var(--cds-chart-categorical-4)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-4)\" stroke-width=\"1.25\"></circle><text x=\"66\" y=\"386\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">1 dřevo</text><rect x=\"148\" y=\"350\" width=\"56\" height=\"44\" rx=\"5\" fill=\"var(--cds-chart-categorical-1)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-1)\" stroke-width=\"1.25\"></rect><text x=\"176\" y=\"377\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">budova</text><text x=\"44\" y=\"408\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">Za 1 jídlo, 1 rudu a 1 dřevo</text><text x=\"44\" y=\"424\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">postavíš budovu a získáš 1</text><text x=\"44\" y=\"440\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">VB.</text></g><g><rect x=\"268\" y=\"284\" width=\"224\" height=\"216\" rx=\"8\" fill=\"none\" stroke=\"var(--cds-chart-axis)\" stroke-width=\"1.25\"></rect><circle cx=\"290\" cy=\"308\" r=\"11\" fill=\"var(--cds-chart-categorical-1)\" fill-opacity=\"0.12\" stroke=\"var(--cds-chart-categorical-1)\" stroke-width=\"1.25\"></circle><text x=\"290\" y=\"312\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">5</text><text x=\"310\" y=\"312\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">Přijde fáze stavu</text><rect x=\"284\" y=\"340\" width=\"34\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-6)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-6)\" stroke-width=\"1.25\"></rect><text x=\"301\" y=\"365\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">1</text><rect x=\"326\" y=\"340\" width=\"34\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-6)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-6)\" stroke-width=\"1.25\"></rect><text x=\"343\" y=\"365\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">2</text><rect x=\"368\" y=\"340\" width=\"34\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-6)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-6)\" stroke-width=\"1.25\"></rect><text x=\"385\" y=\"365\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">3</text><text x=\"408\" y=\"365\" font-size=\"11.5\" fill=\"var(--cds-text-secondary)\">kola</text><text x=\"284\" y=\"408\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">Po třech kolech následuje</text><text x=\"284\" y=\"424\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">fáze stavu: splníš cíle,</text><text x=\"284\" y=\"440\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">vezmeš 2 pokroky zdarma a</text><text x=\"284\" y=\"456\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">dobereš akční kartu a cíl.</text></g><g><rect x=\"508\" y=\"284\" width=\"224\" height=\"216\" rx=\"8\" fill=\"none\" stroke=\"var(--cds-chart-axis)\" stroke-width=\"1.25\"></rect><circle cx=\"530\" cy=\"308\" r=\"11\" fill=\"var(--cds-chart-categorical-1)\" fill-opacity=\"0.12\" stroke=\"var(--cds-chart-categorical-1)\" stroke-width=\"1.25\"></circle><text x=\"530\" y=\"312\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">6</text><text x=\"550\" y=\"312\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">Sečteš body</text><rect x=\"524\" y=\"336\" width=\"38\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-3)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-3)\" stroke-width=\"1.25\"></rect><text x=\"543\" y=\"361\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">1</text><rect x=\"572\" y=\"336\" width=\"38\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-3)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-3)\" stroke-width=\"1.25\"></rect><text x=\"591\" y=\"361\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">½</text><rect x=\"620\" y=\"336\" width=\"38\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-3)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-3)\" stroke-width=\"1.25\"></rect><text x=\"639\" y=\"361\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">2</text><rect x=\"668\" y=\"336\" width=\"38\" height=\"40\" rx=\"5\" fill=\"var(--cds-chart-categorical-3)\" fill-opacity=\"0.25\" stroke=\"var(--cds-chart-categorical-3)\" stroke-width=\"1.25\"></rect><text x=\"687\" y=\"361\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"var(--cds-text-primary)\">4</text><text x=\"543\" y=\"392\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"var(--cds-text-secondary)\">osada</text><text x=\"591\" y=\"392\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"var(--cds-text-secondary)\">pokrok</text><text x=\"639\" y=\"392\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"var(--cds-text-secondary)\">cíl</text><text x=\"687\" y=\"392\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"var(--cds-text-secondary)\">div</text><text x=\"524\" y=\"408\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">Osada a budova dávají po 1</text><text x=\"524\" y=\"424\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">VB, pokrok půl bodu, splněný</text><text x=\"524\" y=\"440\" font-size=\"11.5\" fill=\"var(--cds-text-primary)\">cíl 2 body a div 4 body.</text></g></svg></div><figcaption>ukázka prvních kol · 6 panelů</figcaption></figure>\n\n\n<p>Čísla v obrázcích jsou jen příklad.</p>\n<h2>První kola krok za krokem</h2>\n<ol>\n<li><strong>Založ druhé město</strong> osadníkem: víc měst = větší povolená velikost.</li>\n<li><strong>Sbírej</strong> suroviny podle terénu kolem města.</li>\n<li><strong>Pokrok:</strong> zaplať 2 jídla, např. za Rybaření (přístav) nebo Mýty (chrám).</li>\n<li><strong>Stavěj:</strong> 1 jídlo + 1 ruda + 1 dřevo = budova a +1 VB.</li>\n<li>Po 3 kolech <strong>fáze stavu</strong>: cíle, 2 pokroky zdarma (kratší hra), karty.</li>\n</ol>\n<p>💡 Napovídej: „Druhá aktivace stejného města zhorší náladu. Radši aktivuj různá města.“</p>\n<h2>Boj, události a body</h2>\n<ul>\n<li>Každý 3. pokrok spustí událost. Pak doplň 3 kostky na stopu.</li>\n<li>Barbaři se objevují a jdou k městům. Za každou výhru nad nimi 1 zlato.</li>\n<li>Boj: kostka za jednotku, součet, každých 5 = 1 zásah. Pěšec má +1.</li>\n<li>Na konci: osada a budova 1 VB, pokrok ½, cíl 2, div 4.</li>\n</ul>\n<p>⏸️ Pauza: spočti body obou civilizací po 2. věku a porovnej, co dává víc.</p>\n<h2>Co dál</h2>\n<ul>\n<li>Zahraj plnou hru na 6 věků.</li>\n<li>Přidej civilizace a vůdce, pak piráty.</li>\n<li>U stolu vysvětluj z taháku a dej spoluhráčům českou pomocnou kartu.</li>\n</ul>\n"},{"nazev":"Příprava","html":"<p><strong>Značky:</strong> 🗣️ říkáš nahlas · 🔴 častá chyba · 💡 napovídej · 🔧 jen pro tebe · ⏸️ pauza na otázky · ❓ ověřit v krabici</p>\n<h2>Vydání a zdroje</h2>\n<ul>\n<li>Clash of Cultures: Monumental Edition (WizKids), autor Christian Marcussen, 2–4 hráči, 3–4 hodiny.</li>\n<li>Krabice obsahuje základ, rozšíření Civilizace a Aztéky, miniatury divů.</li>\n<li>Ve sbírce česká verze ❓ <strong>[ověřit]</strong> názvy pojmů v krabici + Kickstarter extras.</li>\n<li>Pravidla čerpána z anglické verze.</li>\n</ul>\n<h2>Rozbor a styl</h2>\n<ul>\n<li>Civilizace v kostce: města, technologie, boj, kultura, bez extrémní délky „civilizace“.</li>\n<li>Hlavní napětí: růst měst proti náladě, pokroky proti událostem, expanze proti obraně.</li>\n<li>Velký strom pokroků; první hra je hlavně o objevování, co který pokrok umí.</li>\n<li>Styl výkladu: cíl → 3 akce → město a nálada → události → boj → fáze stavu a body. Kolem 20 minut.</li>\n</ul>\n<h2>Časté chyby</h2>\n<ul>\n<li>🔴 <strong>Častá chyba:</strong> víc než 2 jídla bez Skladování.</li>\n<li>🔴 <strong>Častá chyba:</strong> stavba v naštvaném městě nebo nad počet měst.</li>\n<li>🔴 <strong>Častá chyba:</strong> spodní pokrok kategorie bez horního.</li>\n<li>🔴 <strong>Častá chyba:</strong> akční karty v boji bez pokroku Taktika (Tactics).</li>\n<li>🔴 <strong>Častá chyba:</strong> pohyb dál po vstupu do hor nebo po bitvě.</li>\n<li>🔴 <strong>Častá chyba:</strong> zapomenout doplnit stopu událostí.</li>\n</ul>\n<h2>Jádro hry</h2>\n<ol>\n<li>6 věků × 3 kola, každý tah 3 akce.</li>\n<li>Města rostou budovami, nálada určuje, kolik dají.</li>\n<li>Pokroky odemykají budovy, jednotky a schopnosti; každý 3. spustí událost.</li>\n<li>Boj kostkami, 5 = zásah; barbaři hrozí všem.</li>\n<li>Fáze stavu: cíle, pokrok zdarma, karty; na konci VB.</li>\n</ol>\n<h2>První hra u stolu</h2>\n<ol>\n<li>Kratší hra (4 věky), bez Civilizací.</li>\n<li>Projděte společně desku pokroků: Zemědělství a Těžba už máte.</li>\n<li>První kolo hrajte nahlas, u každé akce řekněte cenu.</li>\n<li>První událost a první boj vysvětlete, až přijdou.</li>\n</ol>\n<p>🔧 Vůdce, piráty a civilizace přidej až od druhé hry. Hra je dlouhá, naplánuj si celý večer.</p>\n<h2>Zdroje</h2>\n<ul>\n<li><a href=\"https://rulespal.com/clash-of-cultures-monumental-edition/rulebook\">RulesPal: Clash of Cultures Monumental Edition</a></li>\n<li><a href=\"https://dicetower.com/board-game/299659\">Dice Tower: Monumental Edition</a></li>\n<li><a href=\"https://www.tlamagames.com/en/board-games/clash-of-cultures--monumental-edition/\">Tlama Games: Monumental Edition</a></li>\n<li><a href=\"https://opinionatedgamers.com/2023/10/19/dale-yu-review-of-clash-of-cultures-monumental-edition/\">Opinionated Gamers: recenze</a></li>\n</ul>\n"}],"jenKarta":false}